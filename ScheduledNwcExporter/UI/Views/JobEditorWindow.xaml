<Window x:Class="ScheduledNwcExporter.UI.Views.JobEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScheduledNwcExporter.UI.Views"
        Title="Configure Export Job" Height="680" Width="600"
        WindowStartupLocation="CenterOwner" Background="#FFF5F5F5" ResizeMode="NoResize">
    <Window.Resources>
        <local:ValidationColorConverter x:Key="ValidationColorConverter" />
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Model Export Job Configuration" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

        <!-- Source Model Path -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Source Model Path (.rvt):" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding Job.SourceModelPath, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="Local…" Click="BrowseSource_Click" Height="26" Margin="0,0,4,0"/>
                <Button Grid.Column="2" Content="Cloud…" Click="BrowseCloud_Click" Height="26"/>
            </Grid>
        </StackPanel>

        <!-- Output Folder -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Output Folder:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding Job.OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="Browse…" Click="BrowseOutput_Click" Height="26"/>
            </Grid>
        </StackPanel>

        <!-- Filename Template -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Filename Template:" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <TextBlock Text="Tokens: {ModelName}, {ModelFileName}, {Date}, {Time}, {Year}, {Month}, {Day}, {Hour}, {Minute}" FontSize="11" Foreground="Gray" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Job.OutputFileNameTemplate, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Retry Settings & Enabled -->
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Retry Count:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Job.RetryCount}" Width="60" Height="26" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Delay (sec):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Job.RetryDelaySeconds}" Width="60" Height="26" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
            </StackPanel>
            <CheckBox Grid.Column="2" Content="Job Enabled" IsChecked="{Binding Job.IsEnabled}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
        </Grid>

        <!-- Custom Export Settings -->
        <GroupBox Grid.Row="5" Header="Custom Export Settings Overrides" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <CheckBox x:Name="UseCustomSettingsCheckBox" Content="Override Global Export Settings for this Model" IsChecked="{Binding UseCustomSettings}" Margin="0,0,0,10"/>
                
                <Grid IsEnabled="{Binding IsChecked, ElementName=UseCustomSettingsCheckBox}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <CheckBox Content="Convert Element Properties" IsChecked="{Binding Job.CustomExportSettings.ConvertElementProperties}" Margin="0,0,0,6"/>
                        <CheckBox Content="Divide File Into Levels" IsChecked="{Binding Job.CustomExportSettings.DivideFileIntoLevels}" Margin="0,0,0,6"/>
                        <CheckBox Content="Export Element Ids" IsChecked="{Binding Job.CustomExportSettings.ExportElementIds}" Margin="0,0,0,6"/>
                        <CheckBox Content="Export Parts" IsChecked="{Binding Job.CustomExportSettings.ExportParts}" Margin="0,0,0,6"/>
                        <CheckBox Content="Export Internal Coordinates" IsChecked="{Binding Job.CustomExportSettings.ExportInternalCoordinates}" Margin="0,0,0,6"/>
                        <CheckBox Content="Convert Lights (Revit 2020+)" IsChecked="{Binding Job.CustomExportSettings.ConvertLights}" Margin="0,0,0,6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <CheckBox Content="Export Room As Attribute" IsChecked="{Binding Job.CustomExportSettings.ExportRoomAsAttribute}" Margin="0,0,0,6"/>
                        <CheckBox Content="Export Room Geometry" IsChecked="{Binding Job.CustomExportSettings.ExportRoomGeometry}" Margin="0,0,0,6"/>
                        <CheckBox Content="Export URLs" IsChecked="{Binding Job.CustomExportSettings.ExportUrls}" Margin="0,0,0,6"/>
                        <CheckBox Content="Find Missing Materials" IsChecked="{Binding Job.CustomExportSettings.FindMissingMaterials}" Margin="0,0,0,6"/>
                        <CheckBox Content="Export All Parameters" IsChecked="{Binding Job.CustomExportSettings.ExportAllParameters}" Margin="0,0,0,6"/>
                        <CheckBox Content="Export Element Parameters" IsChecked="{Binding Job.CustomExportSettings.ExportElementParameters}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Faceting Factor:" Width="85" VerticalAlignment="Center" FontSize="11"/>
                            <TextBox Text="{Binding Job.CustomExportSettings.FacetingFactor}" Width="60" Height="22" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Validation Status -->
        <TextBlock Grid.Row="6" Text="{Binding ValidationMessage}" FontWeight="SemiBold" Foreground="{Binding ValidationMessage, Converter={StaticResource ValidationColorConverter}}" Margin="0,0,0,15"/>

        <!-- Save / Cancel -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content=" OK " Click="OkButton_Click" Width="80" Height="30" Margin="0,0,8,0" FontWeight="Bold"/>
            <Button Content=" Cancel " Click="CancelButton_Click" Width="80" Height="30"/>
        </StackPanel>
    </Grid>
</Window>
