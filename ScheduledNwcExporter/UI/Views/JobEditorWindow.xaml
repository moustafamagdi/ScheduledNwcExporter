<Window x:Class="ScheduledNwcExporter.UI.Views.JobEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add / Edit Export Job" Height="420" Width="550"
        WindowStartupLocation="CenterOwner" Background="#FFF5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Configure Export Job" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Source Model Path -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Source Revit Model (*.rvt):" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Job.SourceModelPath}" Height="26" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseSourceCommand}" Height="26"/>
            </Grid>
        </StackPanel>

        <!-- Output Directory -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Output Directory:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Job.OutputDirectory}" Height="26" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseOutputCommand}" Height="26"/>
            </Grid>
        </StackPanel>

        <!-- Filename Template -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Output Filename Template:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Job.OutputFileNameTemplate}" Height="26" VerticalContentAlignment="Center"/>
            <TextBlock Text="Supported tokens: {ModelName}, {Date}, {Time}, {Year}, {Month}, {Day}" FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Retry Count & Enabled -->
        <Grid Grid.Row="4" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Retry Count:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Job.RetryCount}" Width="80" Height="26" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
            </StackPanel>
            <CheckBox Grid.Column="1" Content="Job Enabled" IsChecked="{Binding Job.IsEnabled}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
        </Grid>

        <!-- Validation Status -->
        <TextBlock Grid.Row="5" Text="{Binding ValidationMessage}" FontWeight="SemiBold" Foreground="#FF27AE60" Margin="0,0,0,15"/>

        <!-- Save / Cancel -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content=" OK " Click="OkButton_Click" Width="80" Height="30" Margin="0,0,8,0" FontWeight="Bold"/>
            <Button Content=" Cancel " Click="CancelButton_Click" Width="80" Height="30"/>
        </StackPanel>
    </Grid>
</Window>
