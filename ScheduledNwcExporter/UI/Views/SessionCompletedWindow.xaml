<Window x:Class="ScheduledNwcExporter.UI.Views.SessionCompletedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scheduled NWC Export Manager"
        Width="470"
        SizeToContent="Height"
        MinHeight="250"
        MaxHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="#FFF5F5F5">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText"
                   Grid.Row="0"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#FFD9D9D9"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460">
                <TextBlock x:Name="SummaryText"
                           TextWrapping="Wrap"
                           FontSize="12"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <TextBlock Text="Esc to close"
                       Foreground="#FF777777"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       FontSize="11"/>
            <Button Content="Close"
                    Width="86"
                    Height="30"
                    IsCancel="True"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
