<Window x:Class="ScheduledNwcExporter.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScheduledNwcExporter.UI.Views"
        Title="Hatco NWC Exporter" Height="760" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#FFF5F5F5">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:BoolToColorConverter x:Key="BoolToColorConverter" />
        <local:BoolToCloudIconConverter x:Key="BoolToCloudIconConverter" />
        <local:StatusToBackgroundConverter x:Key="StatusToBackgroundConverter" />
        <local:RunHistoryConverter x:Key="RunHistoryConverter" />
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Status Banner -->
        <Border Grid.Row="0" Background="#FF2D2D30" Padding="15" CornerRadius="4" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Hatco NWC Exporter" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Automated batch NWC export suite for Revit 2024 (Hatco BIM Tools)" FontSize="12" Foreground="#FFD0D0D0" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{Binding IsSchedulerEnabled, Converter={StaticResource BoolToColorConverter}}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding NextRunText}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Model Queue List -->
        <GroupBox Grid.Row="1" Header="Export Model Queue" FontWeight="Bold" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content=" + Add Model " Command="{Binding AddModelCommand}" Width="100" Height="28" Margin="0,0,8,0"/>
                        <Button Content=" Edit " Command="{Binding EditModelCommand}" Width="75" Height="28" Margin="0,0,8,0"/>
                        <Button Content=" Remove " Command="{Binding RemoveModelCommand}" Width="75" Height="28" Margin="0,0,8,0"/>
                        <Button Content=" ↻ Refresh Dates " Command="{Binding RefreshModelDatesCommand}" Width="120" Height="28" Margin="0,0,8,0"
                                ToolTip="Refresh local file dates and ACC item metadata without opening models."/>
                        <Button Content=" ↥ Priority " Command="{Binding ResetQueueOrderCommand}" Width="85" Height="28"
                                ToolTip="Restore the action-priority order: late, not exported, failed, then current."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Show:" VerticalAlignment="Center" Foreground="#FF52616B" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding QueueFilters}" SelectedItem="{Binding SelectedQueueFilter}" Width="115" Height="28"
                                  ToolTip="Filter the export queue by readiness, result, or model location."/>
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="QueueDataGrid" Grid.Row="1" ItemsSource="{Binding JobsView}" SelectedItem="{Binding SelectedJob}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True" FontWeight="Normal" Background="White" SelectionMode="Extended">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusToBackgroundConverter}}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" SortMemberPath="IsEnabled" Width="45">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                            <DataGridCheckBoxColumn.EditingElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridCheckBoxColumn.EditingElementStyle>
                        </DataGridCheckBoxColumn>
                        <DataGridTemplateColumn Header="Type" Width="95" SortMemberPath="IsCloud">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding QueueTypeDisplay}" ToolTip="{Binding QueueTypeToolTip}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Source Model" Width="*" MinWidth="220" SortMemberPath="DisplaySourcePath">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplaySourcePath}" ToolTip="{Binding TechnicalSourcePath}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Freshness" Width="175" SortMemberPath="QueuePriority">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding QueueFreshnessDisplay}" ToolTip="{Binding QueueFreshnessToolTip}"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Last Export" Width="100" SortMemberPath="LastSuccessfulExportUtc">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LastSuccessfulExportDisplay}" ToolTip="{Binding ExportLagToolTip}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="NWC Output" Width="185" SortMemberPath="FullOutputPath">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FullOutputPath}" ToolTip="{Binding FullOutputPath}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="State / Progress" Width="150" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="15"/>
                                        <TextBlock Text="{Binding QueueStateDisplay}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="Black" TextTrimming="CharacterEllipsis" ToolTip="{Binding RunHistory, Converter={StaticResource RunHistoryConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- Compact Export Configuration: intentionally no scrollbars -->
        <Border Grid.Row="2" Margin="0,12,0,12" Height="215" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Schedule Card -->
                <Border Grid.Column="0" Background="#FFF7FAFF" BorderBrush="#FFD9E6F5" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="58"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SCHEDULE" FontWeight="Bold" FontSize="11" Foreground="#FF2563EB" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" Content="Enabled" IsChecked="{Binding IsSchedulerEnabled}" FontSize="10"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Select a slot, then set its time and days." FontSize="10" Foreground="#FF64748B" Margin="0,0,0,4"/>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding ScheduleSlots}" SelectedItem="{Binding SelectedSlot}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" FontSize="10" SelectionMode="Single" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled}" Width="32"/>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="48" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Days" Binding="{Binding DaysDisplay}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="3" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding ScheduleHours}" SelectedItem="{Binding SelectedSlot.Hour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="42" Height="21" FontSize="10" IsEnabled="{Binding HasSelectedSlot}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0:D2}}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Column="1" Text=":" FontWeight="Bold" VerticalAlignment="Center" Margin="3,0"/>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding ScheduleMinutes}" SelectedItem="{Binding SelectedSlot.Minute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="42" Height="21" FontSize="10" IsEnabled="{Binding HasSelectedSlot}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0:D2}}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <WrapPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0,4,0" IsEnabled="{Binding HasSelectedSlot}">
                                <CheckBox Content="M" IsChecked="{Binding IsMonday, Mode=TwoWay}" FontSize="10" Margin="0,0,3,0"/>
                                <CheckBox Content="T" IsChecked="{Binding IsTuesday, Mode=TwoWay}" FontSize="10" Margin="0,0,3,0"/>
                                <CheckBox Content="W" IsChecked="{Binding IsWednesday, Mode=TwoWay}" FontSize="10" Margin="0,0,3,0"/>
                                <CheckBox Content="T" IsChecked="{Binding IsThursday, Mode=TwoWay}" FontSize="10" Margin="0,0,3,0"/>
                                <CheckBox Content="F" IsChecked="{Binding IsFriday, Mode=TwoWay}" FontSize="10" Margin="0,0,3,0"/>
                                <CheckBox Content="S" IsChecked="{Binding IsSaturday, Mode=TwoWay}" FontSize="10" Margin="0,0,3,0"/>
                                <CheckBox Content="S" IsChecked="{Binding IsSunday, Mode=TwoWay}" FontSize="10"/>
                            </WrapPanel>
                            <Button Grid.Column="4" Content="+" Command="{Binding AddSlotCommand}" Width="22" Height="21" FontWeight="Bold" Margin="0,0,3,0" ToolTip="Add schedule slot"/>
                            <Button Grid.Column="5" Content="−" Command="{Binding RemoveSlotCommand}" Width="22" Height="21" FontWeight="Bold" ToolTip="Remove selected schedule slot"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- General Export Card -->
                <Border Grid.Column="1" Background="#FFF9FAFB" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="EXPORT BEHAVIOR" FontWeight="Bold" FontSize="11" Foreground="#FF475569" Margin="0,0,0,10"/>
                        <CheckBox Grid.Row="1" Content="Performance Mode" IsChecked="{Binding UseTemporaryCopyWithoutRevitLinks}" FontSize="11" ToolTip="Create a temporary no-link copy before exporting."/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="Existing file:" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox SelectedValue="{Binding OverwritePolicy}" SelectedValuePath="Content" Width="112" Height="22" FontSize="10">
                                <ComboBoxItem Content="Overwrite"/>
                                <ComboBoxItem Content="Skip"/>
                                <ComboBoxItem Content="TimestampedCopy"/>
                            </ComboBox>
                        </StackPanel>
                        <Border Grid.Row="3" Background="#FFF1F5F9" CornerRadius="4" Padding="6" Margin="0,12,0,0">
                            <TextBlock Text="Revit &amp; CAD links are always excluded." TextWrapping="Wrap" FontSize="10" Foreground="#FF475569"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Advanced Options Card -->
                <Border Grid.Column="2" Background="#FFFFFCF7" BorderBrush="#FFF1E5C8" BorderThickness="1" CornerRadius="6" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ADVANCED NWC OPTIONS" FontWeight="Bold" FontSize="11" Foreground="#FFD97706"/>
                            <TextBlock Grid.Column="1" Text="Applies globally unless a job override is enabled" FontSize="9" Foreground="#FF78716C" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <CheckBox Content="Convert Element Properties" IsChecked="{Binding ConvertElementProperties}" FontSize="10" Margin="0,0,0,3"/>
                                <CheckBox Content="Divide File Into Levels" IsChecked="{Binding DivideFileIntoLevels}" FontSize="10" Margin="0,0,0,3"/>
                                <CheckBox Content="Export Element IDs" IsChecked="{Binding ExportElementIds}" FontSize="10" Margin="0,0,0,3"/>
                                <CheckBox Content="Export Parts" IsChecked="{Binding ExportParts}" FontSize="10" Margin="0,0,0,3"/>
                                <CheckBox Content="Internal Coordinates" IsChecked="{Binding ExportInternalCoordinates}" FontSize="10" Margin="0,0,0,3"/>
                                <CheckBox Content="Convert Lights" IsChecked="{Binding ConvertLights}" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <CheckBox Content="Room As Attribute" IsChecked="{Binding ExportRoomAsAttribute}" FontSize="10" Margin="0,0,0,3"/>
                                <CheckBox Content="Room Geometry" IsChecked="{Binding ExportRoomGeometry}" FontSize="10" Margin="0,0,0,3"/>
                                <CheckBox Content="Export URLs" IsChecked="{Binding ExportUrls}" FontSize="10" Margin="0,0,0,3"/>
                                <CheckBox Content="Find Missing Materials" IsChecked="{Binding FindMissingMaterials}" FontSize="10" Margin="0,0,0,3"/>
                                <CheckBox Content="All Parameters" IsChecked="{Binding ExportAllParameters}" FontSize="10" Margin="0,0,0,3"/>
                                <CheckBox Content="Element Parameters" IsChecked="{Binding ExportElementParameters}" FontSize="10"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                            <TextBlock Text="Faceting:" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding FacetingFactor}" Width="52" Height="21" FontSize="10" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Current Activity / Progress -->
        <Border Grid.Row="3" Background="White" BorderBrush="#FFDDDDDD" BorderThickness="1" Padding="12" CornerRadius="4" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Current Activity" FontWeight="Bold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Current Model: " FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CurrentActivityModel}" Foreground="#FF0066CC" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Stage: " FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CurrentActivityStage}"/>
                        <TextBlock Text=" | " Foreground="Gray"/>
                        <TextBlock Text="{Binding EstimatedTimeRemaining}" Foreground="#FF555555" FontStyle="Italic"/>
                    </StackPanel>
                    <TextBlock Text="(If stuck, ensure no Revit dialogs or commands are active)" FontSize="10" Foreground="#FFA0A0A0" FontStyle="Italic" Margin="0,2,0,0"/>
                    <ProgressBar Value="{Binding OverallProgressPercentage}" Minimum="0" Maximum="100" Height="14" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content=" Run Now " Command="{Binding RunNowCommand}" Width="90" Height="30" Margin="0,0,8,0" FontWeight="Bold"/>
                    <Button Content=" Cancel Queue " Command="{Binding PauseCommand}" Width="95" Height="30" Margin="0,0,8,0"/>
                    <Button Content=" Test Job " Command="{Binding TestSelectedCommand}" Width="80" Height="30"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content=" Export Settings… " Command="{Binding ExportSettingsCommand}" Width="110" Height="30" Margin="0,0,8,0"/>
                <Button Content=" Import Settings… " Command="{Binding ImportSettingsCommand}" Width="110" Height="30"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content=" View Log " Command="{Binding ViewLogCommand}" Width="90" Height="30" Margin="0,0,8,0"/>
                <Button Content=" Diagnostics " Command="{Binding OpenSettingsCommand}" Width="90" Height="30" Margin="0,0,8,0"/>
                <Button Content=" Save Config " Command="{Binding SaveConfigurationCommand}" Width="90" Height="30"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
