<Window x:Class="ScheduledNwcExporter.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScheduledNwcExporter.UI.Views"
        Title="Hatco NWC Exporter" Height="750" Width="950"
        WindowStartupLocation="CenterScreen" Background="#FFF5F5F5">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:BoolToColorConverter x:Key="BoolToColorConverter" />
        <local:BoolToCloudIconConverter x:Key="BoolToCloudIconConverter" />
        <local:StatusToBackgroundConverter x:Key="StatusToBackgroundConverter" />
        <local:RunHistoryConverter x:Key="RunHistoryConverter" />
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Status Banner -->
        <Border Grid.Row="0" Background="#FF2D2D30" Padding="15" CornerRadius="4" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Hatco NWC Exporter" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Automated batch NWC export suite for Revit 2024 (Hatco BIM Tools)" FontSize="12" Foreground="#FFD0D0D0" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{Binding IsSchedulerEnabled, Converter={StaticResource BoolToColorConverter}}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding NextRunText}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Model Queue List -->
        <GroupBox Grid.Row="1" Header="Export Model Queue" FontWeight="Bold" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content=" + Add Model " Command="{Binding AddModelCommand}" Width="100" Height="28" Margin="0,0,8,0"/>
                    <Button Content=" Edit " Command="{Binding EditModelCommand}" Width="75" Height="28" Margin="0,0,8,0"/>
                    <Button Content=" Remove " Command="{Binding RemoveModelCommand}" Width="75" Height="28" Margin="0,0,8,0"/>
                </StackPanel>

                <DataGrid x:Name="QueueDataGrid" Grid.Row="1" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" AutoGenerateColumns="False" CanUserAddRows="False" FontWeight="Normal" Background="White" SelectionMode="Extended">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusToBackgroundConverter}}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Loc" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IsCloud, Converter={StaticResource BoolToCloudIconConverter}}" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Cfg" Width="35">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="⚙" Visibility="{Binding HasCustomSettings, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray" ToolTip="Custom Export Overrides Active"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="60">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                            <DataGridCheckBoxColumn.EditingElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridCheckBoxColumn.EditingElementStyle>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn Header="Source Model" Binding="{Binding SourceModelPath}" Width="220" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Output Folder" Binding="{Binding OutputDirectory}" Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Output Filename" Binding="{Binding ResolvedOutputFilename}" Width="150" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Status" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                               ToolTip="{Binding RunHistory, Converter={StaticResource RunHistoryConverter}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Progress" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="4">
                                        <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="14"/>
                                        <TextBlock Text="{Binding CurrentStage}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Last Run" Binding="{Binding LastRun}" Width="115" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- Schedule & Settings Panel (Tabbed or Split) -->
        <TabControl Grid.Row="2" Margin="0,15,0,15" Height="210">
            <!-- Basic Settings & Schedule -->
            <TabItem Header=" Schedule &amp; General " FontWeight="Bold">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Automatic Schedule Slots" FontWeight="Bold" Margin="0,0,0,6"/>
                        <CheckBox Grid.Row="1" Content="Enable Global Scheduler" IsChecked="{Binding IsSchedulerEnabled}" Margin="0,0,0,6"/>
                        
                        <DataGrid Grid.Row="2" ItemsSource="{Binding ScheduleSlots}" SelectedItem="{Binding SelectedSlot}" AutoGenerateColumns="False" CanUserAddRows="False" Height="100" Background="White" FontSize="11">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled}" Width="35"/>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="50" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Days" Binding="{Binding DaysDisplay}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5,0,0">
                            <Button Content=" + Add " Command="{Binding AddSlotCommand}" Width="50" Height="22" FontSize="10" Margin="0,0,5,0"/>
                            <Button Content=" - Remove " Command="{Binding RemoveSlotCommand}" Width="60" Height="22" FontSize="10"/>
                            <TextBlock Text="Note: Revit must remain running." FontSize="10" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Basic Export Behavior" FontWeight="Bold" Margin="0,0,0,6"/>
                        <CheckBox Content="Performance Mode (temporary no-link copy)" IsChecked="{Binding UseTemporaryCopyWithoutRevitLinks}" Margin="0,0,0,6"/>
                        <CheckBox Content="Export Revit Links (disabled by default)" IsChecked="{Binding ExportLinks}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                            <TextBlock Text="Coordinates:" Width="110" VerticalAlignment="Center"/>
                            <ComboBox SelectedValue="{Binding Coordinates}" SelectedValuePath="Content" Width="160" Height="24">
                                <ComboBoxItem Content="Shared"/>
                                <ComboBoxItem Content="Internal"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Overwrite Policy:" Width="110" VerticalAlignment="Center"/>
                            <ComboBox SelectedValue="{Binding OverwritePolicy}" SelectedValuePath="Content" Width="160" Height="24">
                                <ComboBoxItem Content="Overwrite"/>
                                <ComboBoxItem Content="Skip"/>
                                <ComboBoxItem Content="TimestampedCopy"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Advanced Navisworks Options -->
            <TabItem Header=" Advanced Export Options " FontWeight="Bold">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <CheckBox Content="Divide File Into Levels" IsChecked="{Binding DivideFileIntoLevels}" Margin="0,0,0,6"/>
                            <CheckBox Content="Export Parts" IsChecked="{Binding ExportParts}" Margin="0,0,0,6"/>
                            <CheckBox Content="Export URLs" IsChecked="{Binding ExportUrls}" Margin="0,0,0,6"/>
                            <CheckBox Content="Export Room As Attribute" IsChecked="{Binding ExportRoomAsAttribute}" Margin="0,0,0,6"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <CheckBox Content="Convert Lights" IsChecked="{Binding ConvertLights}" Margin="0,0,0,6"/>
                            <CheckBox Content="Find Missing Materials" IsChecked="{Binding FindMissingMaterials}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                                <TextBlock Text="Parameters:" Width="110" VerticalAlignment="Center"/>
                                <ComboBox SelectedValue="{Binding ParameterExportMode}" SelectedValuePath="Content" Width="150" Height="24">
                                    <ComboBoxItem Content="All"/>
                                    <ComboBoxItem Content="Elements"/>
                                    <ComboBoxItem Content="None"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Faceting Factor:" Width="110" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding FacetingFactor}" Width="80" Height="24" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Current Activity / Progress -->
        <Border Grid.Row="3" Background="White" BorderBrush="#FFDDDDDD" BorderThickness="1" Padding="12" CornerRadius="4" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Current Activity" FontWeight="Bold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Current Model: " FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CurrentActivityModel}" Foreground="#FF0066CC" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Stage: " FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CurrentActivityStage}"/>
                        <TextBlock Text=" | " Foreground="Gray"/>
                        <TextBlock Text="{Binding EstimatedTimeRemaining}" Foreground="#FF555555" FontStyle="Italic"/>
                    </StackPanel>
                    <TextBlock Text="(If stuck, ensure no Revit dialogs or commands are active)" FontSize="10" Foreground="#FFA0A0A0" FontStyle="Italic" Margin="0,2,0,0"/>
                    <ProgressBar Value="{Binding OverallProgressPercentage}" Minimum="0" Maximum="100" Height="14" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content=" Run Now " Command="{Binding RunNowCommand}" Width="90" Height="30" Margin="0,0,8,0" FontWeight="Bold"/>
                    <Button Content=" Cancel Queue " Command="{Binding PauseCommand}" Width="95" Height="30" Margin="0,0,8,0"/>
                    <Button Content=" Test Job " Command="{Binding TestSelectedCommand}" Width="80" Height="30"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content=" Export Settings… " Command="{Binding ExportSettingsCommand}" Width="110" Height="30" Margin="0,0,8,0"/>
                <Button Content=" Import Settings… " Command="{Binding ImportSettingsCommand}" Width="110" Height="30"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content=" View Log " Command="{Binding ViewLogCommand}" Width="90" Height="30" Margin="0,0,8,0"/>
                <Button Content=" Diagnostics " Command="{Binding OpenSettingsCommand}" Width="90" Height="30" Margin="0,0,8,0"/>
                <Button Content=" Save Config " Command="{Binding SaveConfigurationCommand}" Width="90" Height="30"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
