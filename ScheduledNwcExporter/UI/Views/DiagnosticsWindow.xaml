<Window x:Class="ScheduledNwcExporter.UI.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostics &amp; System Information" Height="450" Width="600"
        WindowStartupLocation="CenterOwner" Background="#FFF5F5F5"
        xmlns:local="clr-namespace:ScheduledNwcExporter.UI.Views">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="System Diagnostics &amp; Self-Test" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="Run these tests to ensure unattended exports will succeed." Foreground="Gray" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Tests}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="White" GridLinesVisibility="Horizontal" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Stat" Binding="{Binding StatusIcon}" Width="40">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Test Category" Binding="{Binding Title}" Width="180" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Result Details" Binding="{Binding Details}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Orientation="Horizontal">
                <Button Content=" ▶ Run All Tests " Command="{Binding RunTestsCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}" Width="130" Height="32" FontWeight="Bold" Background="#FF007ACC" Foreground="White"/>
                <ProgressBar IsIndeterminate="True" Width="100" Height="4" Margin="15,0,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content=" Copy Report " Click="CopyButton_Click" Width="100" Height="32" Margin="0,0,8,0"/>
                <Button Content=" Close " Click="CloseButton_Click" Width="80" Height="32"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
