<Window x:Class="ScheduledNwcExporter.UI.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostics &amp; System Information" Height="560" Width="900"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner" Background="#FFF5F5F5"
        xmlns:local="clr-namespace:ScheduledNwcExporter.UI.Views">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Diagnostics &amp; Operational Information" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="Versions, exporter availability, cloud sign-in, scheduler/queue state, storage paths and configured job access." Foreground="Gray" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Tests}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="White" GridLinesVisibility="Horizontal" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Stat" Binding="{Binding StatusIcon}" Width="44">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Category" Binding="{Binding Title}" Width="205" FontWeight="SemiBold"/>
                <DataGridTemplateColumn Header="Details" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="4,2"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content=" ▶ Refresh Diagnostics " Command="{Binding RunTestsCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}" Width="155" Height="32" FontWeight="Bold" Background="#FF007ACC" Foreground="White"/>
                <ProgressBar IsIndeterminate="True" Width="100" Height="4" Margin="15,0,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content=" Copy Report " Click="CopyButton_Click" Width="100" Height="32" Margin="0,0,8,0"/>
                <Button Content=" Close " Click="CloseButton_Click" Width="80" Height="32"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
