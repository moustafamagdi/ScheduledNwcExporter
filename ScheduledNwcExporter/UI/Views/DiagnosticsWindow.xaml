<Window x:Class="ScheduledNwcExporter.UI.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostics &amp; System Information" Height="450" Width="600"
        WindowStartupLocation="CenterOwner" Background="#FFF5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Diagnostics Information" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBox x:Name="DiagnosticTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Background="White" Padding="8"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content=" Copy Diagnostics " Click="CopyButton_Click" Width="120" Height="30" Margin="0,0,8,0"/>
            <Button Content=" Close " Click="CloseButton_Click" Width="80" Height="30"/>
        </StackPanel>
    </Grid>
</Window>
