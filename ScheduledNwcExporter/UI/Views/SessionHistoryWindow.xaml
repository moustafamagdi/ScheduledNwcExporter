<Window x:Class="ScheduledNwcExporter.UI.Views.SessionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Session History" Height="620" Width="1000"
        WindowStartupLocation="CenterOwner" Background="#FFF5F5F5">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Export Session History" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Recent manual and scheduled NWC batches. Select a session to inspect per-model results." Foreground="#FF64748B" Margin="0,3,0,0"/>
        </StackPanel>

        <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="HistoryGrid_SelectionChanged" Background="White" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Started" Binding="{Binding StartedDisplay}" Width="145"/>
                <DataGridTextColumn Header="Trigger" Binding="{Binding TriggerSource}" Width="85"/>
                <DataGridTextColumn Header="Result" Binding="{Binding ResultDisplay}" Width="130"/>
                <DataGridTextColumn Header="Success" Binding="{Binding Successful}" Width="65"/>
                <DataGridTextColumn Header="Failed" Binding="{Binding Failed}" Width="60"/>
                <DataGridTextColumn Header="Skipped" Binding="{Binding Skipped}" Width="65"/>
                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="80"/>
                <DataGridTextColumn Header="Session ID" Binding="{Binding SessionId}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBox x:Name="DetailsText" Grid.Row="2" Margin="0,10,0,10" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Background="White" FontFamily="Consolas" FontSize="11"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Open Report" Click="OpenReport_Click" Width="95" Height="30" Margin="0,0,8,0"/>
            <Button Content="Refresh" Click="Refresh_Click" Width="80" Height="30" Margin="0,0,8,0"/>
            <Button Content="Close" Click="Close_Click" Width="80" Height="30"/>
        </StackPanel>
    </Grid>
</Window>
